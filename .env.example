APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Option A: full URL (takes precedence if set)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multi_agent

# Option B: discrete DB settings
DB_NAME=multi_agent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

LLM_PROVIDER=openai
EMBED_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
